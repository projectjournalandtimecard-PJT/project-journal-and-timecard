name: Build installers
# Windows .exe (NSIS) on windows-latest, macOS .dmg on macos-latest (Apple
# Silicon). WiX/MSI is deliberately absent — candle.exe chokes on the
# ampersand in "Project Journal & Timecard". Runs on every push to main and
# can be started manually from the Actions tab (Run workflow).
on:
  push:
    branches: [ main ]
  workflow_dispatch:
jobs:
  build:
    strategy:
      fail-fast: false
      matrix:
        include:
          - os: windows-latest
            label: windows
            bundles: nsis
            artifact_path: src-tauri/target/release/bundle/nsis/*.exe
          - os: macos-latest
            label: macos-arm64
            bundles: dmg
            artifact_path: src-tauri/target/release/bundle/dmg/*.dmg
    runs-on: ${{ matrix.os }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4
      - name: Install Rust (stable)
        uses: dtolnay/rust-toolchain@stable
      - name: Cache Rust build
        uses: swatinem/rust-cache@v2
        with:
          workspaces: src-tauri -> target
      - name: Install Tauri CLI (v2)
        run: cargo install tauri-cli --version "^2.0" --locked
      - name: Build installers
        run: cargo tauri build --bundles ${{ matrix.bundles }}
      - name: Upload installers
        uses: actions/upload-artifact@v4
        with:
          name: pjt-${{ matrix.label }}-installer
          path: ${{ matrix.artifact_path }}
          if-no-files-found: error
"icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ]
